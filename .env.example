# Gemini API key. Get a free one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model. Leave unset to use the code's current
# default (gemini-2.5-flash). Do not pin this to an old model name unless
# you know it is still served — Google retires older Gemini versions, and a
# retired model returns an error on every single request, which looks
# exactly like every eval case failing at once.
# GEMINI_MODEL=gemini-2.5-flash
